/*
 * Settings for the sex-survival pipeline.
 * Override any param on the command line, e.g.  --cancers STAD,THCA
 */
manifest {
    name            = 'sex-survival'
    description     = 'Sex differences in survival across TCGA cancers'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    cancers    = 'STAD,ESCA,COAD,LUAD,THCA'
    xena_hub   = 'https://gdc.xenahubs.net/download'
    raw_dir    = "${projectDir}/data/raw"     // downloaded once, kept here
    outdir     = 'results'
    min_events = 40                           // flag sex-specific models below this
}

process {
    cpus   = 1
    memory = 2.GB
    // never ask for more than a laptop has
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 2.h ]

    // 5 downloads at once would hammer the server; the rest is light
    withName: 'DOWNLOAD' { maxForks = 2 }
}

// every step runs inside this container image, pulled automatically from Docker Hub
// (built from envs/Dockerfile + envs/analysis.yml in this repository)
process.container = 'caglayaniris/sex-survival:0.1.0'

docker {
    enabled    = true
    // files written by the container belong to you, not to root
    runOptions = '-u $(id -u):$(id -g)'
}

profiles {
    // quick check for graders: 2 cancers only
    test { includeConfig 'conf/test.config' }
}

// run records
def stamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${stamp}.html" }
