/*
 * Group stages into I-IV, convert survival to years, drop unusable patients,
 * then run sanity checks. The cleaned table is saved to data/processed/
 * (regenerated by the pipeline; data/raw/ is never modified).
 */
process CLEAN_CLINICAL {
    tag "$cancer"
    publishDir "${projectDir}/data/processed", mode: 'copy', pattern: '*_clean.csv'
    publishDir "${params.outdir}/clean",       mode: 'copy'

    input:
    tuple val(cancer), path(patients)

    output:
    tuple val(cancer), path("${cancer}_clean.csv"), emit: clean
    path "${cancer}_dropped.csv",                   emit: dropped

    script:
    """
    clean_clinical.py --cancer ${cancer} --patients ${patients} --outdir .
    """
}
